{
  "name": "dsh-plugin-work-notes",
  "version": "1.0.0",
  "description": "DSH（DeepSeek Harness）插件：工作便签——左侧栏便签面板，便签画布自由摆放、月历与甘特图拖拽改期，数据只存本机浏览器",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes",
    "work-notes",
    "calendar",
    "gantt"
  ],
  "license": "MIT",
  "author": "Gewuji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gewuji/dsh-plugin-work-notes.git"
  },
  "homepage": "https://github.com/Gewuji/dsh-plugin-work-notes#readme",
  "bugs": {
    "url": "https://github.com/Gewuji/dsh-plugin-work-notes/issues"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
